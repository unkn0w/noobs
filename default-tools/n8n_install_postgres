#!/bin/bash
#
# Skrypt instalujący aplikację N8N - wersja ze wsparciem dla PostgreSQL
# Dostosowany do użycia w środowisku Mikrusa - https://mikr.us
#

MINIMALRAM=2000

# kolorki
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
NORMAL='\033[0m'

availableMemory=$(free -m | awk '/^(Mem|Pam)/ {print $2}')

if [ ${availableMemory} -gt ${MINIMALRAM} ]; then
    echo -e "${GREEN}System ma ponad ${MINIMALRAM}MB pamięci RAM${NORMAL}"
else
    echo -e "${RED}System ma mniej niż ${MINIMALRAM}MB pamięci RAM - to nie zadziała...${NORMAL}"
    exit 2
fi

# --- podział pamięci ---------------------------------------------------------
# Tu działają DWA kontenery: n8n (Node) i pg_n8n (PostgreSQL). Każdy dostaje
# własny twardy limit cgroup, a Node wewnątrz kontenera n8n ma jeszcze sufit
# sterty (--max-old-space-size) wyraźnie niższy od limitu swojego kontenera:
#   - narzut V8 procesu głównego ~130 MB
#   - osobny proces "JS Task Runner" (N8N_RUNNERS_ENABLED=true) ~150-250 MB
# Zostawiamy zapas RAM dla systemu VPS-a i demona Dockera poza kontenerami.
# Stare wyliczenie dawało kontenerowi n8n RAM-100 (a Postgresowi nic) i kończyło
# się OOM-killem node albo postgresa przy realnym obciążeniu.
OS_RESERVE=512                                    # OS + dockerd + watchtower + cache
PG_MEM=512                                        # twardy limit dla kontenera PostgreSQL
containerMem=$(( availableMemory - OS_RESERVE - PG_MEM ))
[ "$containerMem" -lt 512 ] && containerMem=512

nodeHeap=$(( containerMem * 70 / 100 ))           # 70% limitu kontenera n8n
heapCap=$(( containerMem - 320 ))                 # rezerwa na narzut V8 + task runner
[ "$nodeHeap" -gt "$heapCap" ] && nodeHeap=$heapCap
[ "$nodeHeap" -lt 384 ] && nodeHeap=384

echo -e " ${GREEN}> Limit n8n: ${containerMem} MB (sterta Node ${nodeHeap} MB), limit PostgreSQL: ${PG_MEM} MB${NORMAL}"
# ---------------------------------------------------------------------------

# wczytanie konfiguracji z pliku (jeśli istnieje)
CONFIG_FILE="/root/.n8n/mikrus.cfg"
if [ -f "$CONFIG_FILE" ]; then
    echo -e " ${GREEN}> Wczytuję konfigurację z pliku${NORMAL}"
    source "$CONFIG_FILE"
    saved_port="$PORT"
    saved_domain="$DOMAIN"
fi

# alternatywny numer portu
if [ -n "$1" ] && [[ "$1" =~ ^[0-9]+$ ]]; then
    portNR=$1
    echo -e " ${GREEN}> Używam podanego portu: ${portNR}${NORMAL}"
elif [ -n "$saved_port" ]; then
    portNR="$saved_port"
    echo -e " ${GREEN}> Używam portu z pliku konfiguracyjnego: ${portNR}${NORMAL}"
else
    id="$(hostname)"; id="${id##*[!0-9]}"
    portNR="20${id}"
    echo -e " ${GREEN}> Używam domyślnego portu: ${portNR}${NORMAL}"
fi

# mamy dockera?
if command -v docker &> /dev/null; then
    echo -e " ${GREEN}> Docker jest zainstalowany${NORMAL}"
else
    echo -e " ${YELLOW}> Instaluję Dockera${NORMAL}"
    curl -fsSL https://get.docker.com | sh -
fi

if [ ! -d ~/.n8n ]; then
    echo -e " ${YELLOW}> Tworzę katalog domowy dla N8N${NORMAL}";
    mkdir ~/.n8n
    chown -R 1000:root ~/.n8n
else
    echo -e " ${GREEN}> Katalog domowy już istnieje - użyję go${NORMAL}"
fi

if [ ! -d ~/.pg_n8n ]; then
    echo -e " ${YELLOW}> Tworzę katalog domowy dla PostgreSQL${NORMAL}";
    mkdir ~/.pg_n8n
else
    echo -e " ${GREEN}> Katalog dla PostgreSQL już istnieje - użyję go${NORMAL}"
fi

echo -e " ${GREEN}> Uruchamiam kontener...${NORMAL}"


# wsparcie dla alternatywnej domeny do webhooków
if [ -n "$2" ] && [[ "$2" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]]; then
    domain="$2"
    echo -e " ${GREEN}> Używam podanej domeny: ${domain}${NORMAL}"
elif [ -n "$saved_domain" ] && [ -z "$1" ] && [ -z "$2" ]; then
    domain="$saved_domain"
    echo -e " ${GREEN}> Używam domeny z pliku konfiguracyjnego: ${domain}${NORMAL}"
else
    eval $(curl -s -k -6 https://info.mikr.us)
    domain="${info_imie_id}-${portNR}.wykr.es"
    echo -e " ${GREEN}> Używam domyślnej domeny: ${domain}${NORMAL}"
fi

# zapisanie konfiguracji do pliku
echo -e " ${GREEN}> Zapisuję konfigurację do pliku${NORMAL}"
cat > "$CONFIG_FILE" << EOF
PORT=${portNR}
DOMAIN=${domain}
EOF

# porządki
docker rm -f n8n >/dev/null 2>&1
docker rm -f pg_n8n >/dev/null 2>&1
docker rm -f watchtower_n8n >/dev/null 2>&1
docker pull n8nio/n8n:latest
#docker pull postgres:13
# n8n aktualnie wymaga Postgres 16+ (17 zalecany, 15 juz nie jest wspierany) - nowe instalacje
# dostaja pg17. Jesli w ~/.pg_n8n jest juz zainicjalizowana baza starszej wersji (np. z wczesniejszej
# instalacji tym skryptem), trzeba uzyc zgodnego obrazu, bo Postgres nie czyta danych innej wersji
# majorowej bez pg_upgrade - podmiana binarki "w miejscu" nie uruchomi sie wcale.
PG_IMAGE_TAG="pg17"
if [ -f ~/.pg_n8n/PG_VERSION ]; then
  existing_pg_version="$(cat ~/.pg_n8n/PG_VERSION)"
  PG_IMAGE_TAG="pg${existing_pg_version}"
  echo -e "${YELLOW}Wykryto istniejące dane PostgreSQL w wersji ${existing_pg_version} - używam zgodnego obrazu pgvector/pgvector:${PG_IMAGE_TAG}${NORMAL}"
fi
docker pull pgvector/pgvector:${PG_IMAGE_TAG}
docker pull nickfedor/watchtower

#uruchamiamy DB
docker run -itd \
  -e POSTGRES_USER=n8n \
  -e POSTGRES_PASSWORD=n8n \
  -e POSTGRES_DB=n8n \
  --memory=${PG_MEM}m \
  --memory-swap=${PG_MEM}m \
  --memory-swappiness=0 \
  --restart unless-stopped \
  --name pg_n8n \
  -v ~/.pg_n8n:/var/lib/postgresql/data \
  pgvector/pgvector:${PG_IMAGE_TAG}

until docker exec pg_n8n pg_isready -q; do
  echo "Czekam na PostgreSQL..."
  sleep 5
done

docker exec -it pg_n8n psql -U n8n -c "create extension if not exists vector;"

# uruchamiamy n8n
docker run -itd \
  --memory=${containerMem}m \
  --memory-swap=${containerMem}m \
  --memory-swappiness=0 \
  --name n8n \
  -p ${portNR}:5678 \
  -v ~/.n8n:/home/node/.n8n \
  --restart unless-stopped \
  -e DB_POSTGRESDB_HOST=db \
  -e DB_POSTGRESDB_PORT=5432 \
  -e DB_POSTGRESDB_DATABASE=n8n \
  -e DB_POSTGRESDB_USER=n8n \
  -e DB_POSTGRESDB_PASSWORD=n8n \
  -e DB_TYPE=postgresdb \
  -e N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true \
  -e N8N_RUNNERS_ENABLED=true \
  -e N8N_RUNNERS_MAX_PAYLOAD=536870912 \
  -e N8N_DIAGNOSTICS_ENABLED=false \
  -e N8N_METRICS=false \
  -e EXECUTIONS_DATA_PRUNE=true \
  -e EXECUTIONS_DATA_MAX_AGE=336 \
  -e EXECUTIONS_DATA_PRUNE_MAX_COUNT=2000 \
  -e NODE_OPTIONS=--max-old-space-size=${nodeHeap} \
  -e GENERIC_TIMEZONE="Europe/Warsaw" \
  -e WEBHOOK_URL=https://${domain} \
  --link pg_n8n:db \
  n8nio/n8n:latest

docker run -d \
  --name watchtower_n8n \
  --restart unless-stopped \
  -e WATCHTOWER_POLL_INTERVAL=259200 \
  -v /var/run/docker.sock:/var/run/docker.sock \
  nickfedor/watchtower \
  n8n --cleanup

echo -n -e " ${GREEN}> Startowanie aplikacji...${NORMAL}"

cnt=25

while [ -z "$(docker logs n8n | grep accessible)" ]; do
  if [ $cnt -eq 0 ]; then
    echo -e "${RED}Coś nie działa :(${NORMAL}"
    exit 2
  fi
  echo -n "."
  sleep 5
  cnt=$[$cnt-1]
done

echo -e "\n\n"

# aktywujemy backup dla usera
/bin/n8n_backup

echo -e "\n\n${GREEN}Twoja instancja N8N jest pod adresem:${NORMAL}\n"
echo -e "https://${domain}\n\n"

echo -e "\n${NORMAL}Gdy będziesz chciał zaktualizować swoją instancję użyj ${YELLOW}n8n_update${NORMAL}\n\n"
